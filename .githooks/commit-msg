#!/usr/bin/env bash
# Cursor/에이전트가 붙이는 co-author·attribution trailer 제거
set -euo pipefail

MSG_FILE="${1:?}"
[[ -f "${MSG_FILE}" ]] || exit 0

sed -i \
  -e '/^Co-authored-by:.*[Cc]ursor/d' \
  -e '/cursoragent@cursor\.com/d' \
  -e '/^Made-with:.*[Cc]ursor/I d' \
  -e '/^Co-authored-by:.*ROKEY-SPARK/d' \
  "${MSG_FILE}"
