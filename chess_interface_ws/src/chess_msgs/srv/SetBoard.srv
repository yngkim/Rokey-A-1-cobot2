# Manually set the logical board FEN (web UI correction).
string fen
# Optional JSON array (length 16) of captured piece symbols for robot graveyard sync.
string graveyard_slots_json
# Optional JSON array (length 16) for human/opponent graveyard sync.
string human_graveyard_slots_json
# Human player color (white|black) for graveyard side sync on robot node.
string human_color
# Board orientation: standard | flipped (physical 180° board).
string board_orientation
---
bool success
string message
string fen
BoardState board_state
